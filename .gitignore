# ESPN scraped data (regenerable via espn_backfill.py)
data/espn_wp/*.jsonl
data/pbp/*.jsonl

# Kalshi orderbook snapshots (irreplaceable — backed up to personal cloud)
data/orderbook_snapshots/

# WP vs Kalshi paired analysis — raw API caches are large, gitignored.
data/wp_kalshi_paired/*.json
# Per-game paired CSVs are uploaded as GH Actions artifacts
# (90-day retention) and synced locally via
# scripts/sync_paired_data.sh. Not tracked in git to avoid
# repo bloat. Migrated 2026-04-30 from briefly-tracked
# (2026-04-28..30) to artifact-based; see RESEARCH_LOG entry
# "forward_collection migrated to artifact-based architecture".
# Audit logs (forward_runs/<date>.log), matched_games.csv,
# aggregate_summary.csv, and other named aggregate CSVs at
# the top level remain tracked as they always have.
data/wp_kalshi_paired/*_timeseries.csv
data/wp_kalshi_paired/*_scoring_plays.csv
